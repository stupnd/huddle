# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Claude API
ANTHROPIC_API_KEY=sk-ant-...
LISTENER_MODEL=claude-haiku-4-5-20251001
AGENT_MODEL=claude-sonnet-5

# Messaging: "simulator" for local dev, "claw" for real iMessage via Claw Messenger
MESSAGING_PROVIDER=simulator

# Claw Messenger (https://www.clawmessenger.com/dashboard)
CLAW_API_KEY=cm_live_...

# Sendblue (optional, only if you get a plan with group messaging)
SENDBLUE_API_KEY_ID=
SENDBLUE_API_SECRET_KEY=
SENDBLUE_FROM_NUMBER=

# Speak-when-needed tuning (seconds)
LULL_SECONDS=90
COOLDOWN_SECONDS=1800

# Public URL of the app (used in links posted to the chat)
APP_URL=http://localhost:3000

# Shared secret for /api/tick when called by a cron (not needed with the Claw worker)
TICK_SECRET=change-me
